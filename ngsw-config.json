{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/icons/*.png",
          "/fonts/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/temario/**"
        ]
      }
    },
    {
      "name": "study-materials",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/apuntes/**",
          "/descargas/**"
        ]
      }
    },
    {
      "name": "php-runtime",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/php-runtime/**"
        ]
      }
    }
  ]
}
