{
  "name": "modo-estudio",
  "version": "17.0.0",
  "private": true,
  "description": "ESTUDIO: banco por asignaturas y unidades, DWCS y Despregamento de Apps. Web, práctica rápida y simulacros simplificados",
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "check:bank": "node tools/check-questions.mjs",
    "check": "npm run check:bank && npm run check:assets && npm run check:types && npm run check:templates && npm run check:coverage && npm run check:selection && npm run check:persistence && npm run check:projects && npm run check:editor-scope",
    "check:assets": "node tools/check-preserved-assets.mjs",
    "check:selection": "node tools/check-selection.mjs",
    "check:persistence": "node tools/check-study-persistence.mjs",
    "check:projects": "node tools/check-project-content.mjs",
    "test:runtime": "node tools/runtime-poc.mjs --bank",
    "test:projects": "node tools/check-project-runtime.mjs",
    "test:quick": "node tools/runtime-quick-ui.mjs --production",
    "test:laboratory": "node tools/check-mockup-integration.mjs",
    "test:workspace": "node tools/check-mockup-integration.mjs",
    "test:visual": "node tools/check-mockup-integration.mjs",
    "test:editor": "node tools/check-editor.mjs",
    "test:runtime-editor": "node tools/runtime-editor-check.mjs",
    "test:evaluation": "node tools/check-project-evaluation.mjs",
    "test:editor-offline": "node tools/check-editor-offline.mjs",
    "test:simple-php": "node tools/check-simple-php.mjs",
    "check:editor-scope": "node tools/check-editor-scope.mjs",
    "test:mobile": "node tools/check-study-mobile.mjs --production --offline",
    "test:project-storage": "node tools/check-project-storage.mjs",
    "test:images": "node tools/check-image-viewer.mjs",
    "check:coverage": "node tools/audit-coverage.mjs",
    "check:types": "node node_modules/typescript/bin/tsc --project tsconfig.app.json --noEmit",
    "check:templates": "node node_modules/@angular/compiler-cli/bundles/src/bin/ngc.js -p tsconfig.app.json",
    "php:runner": "node tools/php-runner/server.mjs",
    "start:php": "ng serve --host 127.0.0.1 --proxy-config proxy.php.json",
    "check:php": "node tools/php-runner/check-fixtures.mjs"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@angular/service-worker": "~21.2.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@lezer/highlight": "^1.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "playwright": "^1.61.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module"
}
