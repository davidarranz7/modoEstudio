{
  "name": "modo-estudio",
  "version": "6.0.0",
  "private": true,
  "description": "Plataforma móvil ESTUDIO con banco DWCS de 379 preguntas y modos de escribir e interpretar PHP",
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "check:bank": "node tools/check-questions.mjs",
    "check": "npm run check:bank && npm run build"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@angular/service-worker": "~21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module"
}
